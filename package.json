{
  "name": "spectral",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "prompt:print": "tsx scripts/print-system-prompt.ts",
    "install:services": "npm install --prefix spectral/backend && npm install --prefix spectral/driver",
    "dev:backend": "npm --prefix spectral/backend run dev",
    "dev:driver": "npm --prefix spectral/driver run dev",
    "pair:driver": "npm --prefix spectral/driver run pair",
    "typecheck:backend": "npm --prefix spectral/backend run typecheck",
    "typecheck:driver": "npm --prefix spectral/driver run typecheck",
    "typecheck:services": "npm run typecheck:backend && npm run typecheck:driver"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/openai": "^4.0.105",
    "@ai-sdk/react": "^4.0.161",
    "@auth/drizzle-adapter": "^1.7.4",
    "@base-ui/react": "^1.9.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "ai": "^7.0.157",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.38.4",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.25",
    "opencode-ai": "^1.19.5",
    "phosphor-react": "^1.4.1",
    "postgres": "^3.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "minimatch": "^9.0.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
